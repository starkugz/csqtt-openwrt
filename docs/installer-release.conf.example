# Источник пакетов CSQTT. При необходимости скопируйте в
# /etc/csqtt-installer-release.conf или передайте путь через --release-conf.
# Пустой тег выбирает последний опубликованный выпуск через GitHub API.
# Для закрепления выпуска задайте CSQTT_RELEASE_TAG=v2.5.3.
# Значения окружения сохраняются.
CSQTT_RELEASE_OWNER=${CSQTT_RELEASE_OWNER:-starkugz}
CSQTT_RELEASE_REPO=${CSQTT_RELEASE_REPO:-csqtt-openwrt}
CSQTT_RELEASE_TAG=${CSQTT_RELEASE_TAG:-}
